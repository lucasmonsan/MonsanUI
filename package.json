{
	"name": "monsan-ui",
	"private": true,
	"version": "0.0.2",
	"license": "AGPL-3.0-only",
	"packageManager": "pnpm@11.17.0",
	"engines": {
		"node": ">=22.13.0"
	},
	"monsanSuite": {
		"type": "ui",
		"publicProduct": false,
		"usesMonsanUI": false,
		"requiresSSO": false,
		"requiresSEO": false,
		"hasDirectus": false,
		"hasLanding": false
	},
	"scripts": {
		"dev": "pnpm run dev:fresh",
		"dev:fast": "vite dev --host --force",
		"dev:fresh": "rm -rf node_modules .svelte-kit build dist && pnpm install && pnpm test && vite dev --host --force",
		"build": "vite build",
		"build:package": "svelte-kit sync && svelte-package",
		"preview": "vite preview",
		"prepare": "svelte-kit sync && svelte-package",
		"prepare:local": "svelte-kit sync && svelte-package",
		"prepack:local": "svelte-kit sync && svelte-package && publint",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"typecheck": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json && tsc --noEmit",
		"lint": "prettier --check . && eslint .",
		"lint:package": "publint run --pack false",
		"test:standards": "node tests/consumer-standards.test.mjs",
		"test:defaults": "node tests/component-defaults.test.mjs && node tests/color-contrast.test.mjs",
		"test:tooling": "node tests/tooling-standards.test.mjs",
		"test:propagation": "node --check scripts/propagate-monsan-ui.mjs && node tests/propagate-monsan-ui.test.mjs",
		"test:browser-compat": "node scripts/check-browser-compat.mjs",
		"format": "prettier --write .",
		"test": "pnpm lint && pnpm typecheck && pnpm run test:browser-compat && pnpm run test:standards && pnpm run test:defaults && pnpm run test:tooling && pnpm run test:propagation && pnpm build && pnpm run build:package && pnpm run lint:package && node tests/portugol.test.mjs && node --test tests/javascript-runner.test.mjs && node --test tests/javascript-reference.test.mjs",
		"test:latest": "pnpm update && pnpm test"
	},
	"files": [
		"dist",
		"!dist/**/*.test.*",
		"!dist/**/*.spec.*"
	],
	"sideEffects": [
		"**/*.css"
	],
	"svelte": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"type": "module",
	"bin": {
		"monsan-ui-check-consumer": "./dist/standards/check-consumer-standards.js",
		"monsan-ui-check-tooling": "./dist/standards/check-tooling-standards.js"
	},
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"svelte": "./dist/index.js",
			"import": "./dist/index.js",
			"default": "./dist/index.js"
		},
		"./monsan-ui.css": "./dist/monsan-ui.css",
		"./variables.css": "./dist/variables.css"
	},
	"peerDependencies": {
		"@sveltejs/kit": "^2.0.0",
		"svelte": "^5.0.0"
	},
	"dependencies": {
		"@codemirror/commands": "^6.10.4",
		"@codemirror/lang-javascript": "^6.2.5",
		"@codemirror/language": "^6.12.4",
		"@codemirror/state": "^6.7.0",
		"@codemirror/view": "^6.43.3",
		"@lezer/highlight": "^1.2.3",
		"codemirror": "^6.0.2",
		"modern-normalize": "^3.0.1",
		"phosphor-svelte": "^3.1.0"
	},
	"devDependencies": {
		"@eslint/compat": "^2.1.0",
		"@eslint/js": "^10.0.1",
		"@sveltejs/adapter-auto": "^7.0.1",
		"@sveltejs/adapter-static": "^3.0.10",
		"@sveltejs/kit": "^2.70.1",
		"@sveltejs/package": "^2.5.7",
		"@sveltejs/vite-plugin-svelte": "^7.2.0",
		"@types/node": "^22.19.19",
		"eslint": "^10.8.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.22.0",
		"globals": "^17.8.0",
		"prettier": "^3.9.6",
		"prettier-plugin-svelte": "^4.1.1",
		"publint": "^0.3.21",
		"svelte": "^5.56.8",
		"svelte-check": "^4.7.4",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.65.0",
		"vite": "^8.1.5"
	},
	"keywords": [
		"svelte"
	]
}
