{
	"name": "monsan-ui",
	"version": "0.0.1",
	"license": "AGPL-3.0-only",
	"packageManager": "pnpm@10.33.4",
	"engines": {
		"node": ">=22.12.0"
	},
	"scripts": {
		"dev": "vite dev --host --force",
		"build": "vite build",
		"build:package": "svelte-kit sync && svelte-package",
		"preview": "vite preview",
		"prepare": "svelte-kit sync && svelte-package",
		"prepare:local": "svelte-kit sync && svelte-package",
		"prepack:local": "svelte-kit sync && svelte-package && publint",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"typecheck": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json && tsc --noEmit",
		"lint": "prettier --check . && eslint .",
		"lint:package": "publint run --pack false",
		"format": "prettier --write .",
		"test": "pnpm lint && pnpm typecheck && pnpm build && pnpm run build:package && pnpm run lint:package",
		"test:latest": "pnpm update && pnpm test"
	},
	"files": [
		"dist",
		"!dist/**/*.test.*",
		"!dist/**/*.spec.*"
	],
	"sideEffects": [
		"**/*.css"
	],
	"svelte": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"type": "module",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"svelte": "./dist/index.js"
		},
		"./monsan-ui.css": "./dist/monsan-ui.css",
		"./variables.css": "./dist/variables.css"
	},
	"peerDependencies": {
		"svelte": "^5.0.0"
	},
	"dependencies": {
		"modern-normalize": "^3.0.1"
	},
	"devDependencies": {
		"@eslint/compat": "^2.1.0",
		"@eslint/js": "^10.0.1",
		"@sveltejs/adapter-auto": "^7.0.1",
		"@sveltejs/adapter-static": "^3.0.10",
		"@sveltejs/kit": "^2.61.1",
		"@sveltejs/package": "^2.5.7",
		"@sveltejs/vite-plugin-svelte": "^7.1.2",
		"@types/node": "^22.19.19",
		"eslint": "^10.4.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.18.0",
		"globals": "^17.6.0",
		"prettier": "^3.8.3",
		"prettier-plugin-svelte": "^3.5.2",
		"publint": "^0.3.21",
		"svelte": "^5.55.9",
		"svelte-check": "^4.4.8",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.60.0",
		"vite": "^8.0.14"
	},
	"pnpm": {
		"onlyBuiltDependencies": [
			"esbuild"
		]
	},
	"keywords": [
		"svelte"
	]
}
